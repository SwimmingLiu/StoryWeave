{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-skills.local/storyweave/outline_draft.schema.json",
  "title": "Storyweave storyboard draft",
  "type": "object",
  "required": ["schema_version", "status", "title", "audience", "purpose", "page_count", "central_message", "narrative", "slides"],
  "properties": {
    "schema_version": { "const": 2 },
    "status": { "const": "draft" },
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "page_count": { "type": "integer", "minimum": 1 },
    "central_message": { "type": "string", "minLength": 1 },
    "narrative": {
      "type": "object",
      "required": ["opening", "problem", "insight", "method", "action"],
      "additionalProperties": false,
      "properties": {
        "opening": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 },
        "insight": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "required": ["id", "role", "purpose", "claim", "exact_text", "evidence", "visual_brief", "transition"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "role": { "enum": ["cover", "section", "statement", "image-hero", "two-column", "comparison", "process", "data", "quote", "closing"] },
        "purpose": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "exact_text": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array" },
        "visual_brief": { "type": "string", "minLength": 1 },
        "visual_anchor_id": { "type": "string", "minLength": 1 },
        "continuity_group": { "type": "string", "minLength": 1 },
        "transition": { "type": "string", "minLength": 1 },
        "sources": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
