{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-skills.local/storyweave-html/outline_draft.schema.json",
  "title": "StoryWeave HTML draft content by schema version",
  "$comment": "Version routing preserves legacy theme and visual_spec contracts while v4 content comes from the shared core schema.",
  "oneOf": [
    {
      "$ref": "outline_draft.v2.schema.json"
    },
    {
      "$ref": "outline_draft.v3.schema.json"
    },
    {
      "allOf": [
        {
          "$ref": "content_v4.schema.json"
        },
        {
          "properties": {
            "status": {
              "const": "draft"
            }
          }
        }
      ]
    }
  ]
}
