{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-skills.local/storyweave-imagegen/generation_manifest.schema.json",
  "title": "Storyweave Imagegen full-slide manifest v3",
  "type": "object",
  "required": ["schema_version", "title", "mode", "catalog_scope", "theme_ref", "theme_recipe_sha256", "deck_spec_sha256", "provider", "canvas", "slides"],
  "properties": {
    "schema_version": { "const": 3 },
    "title": { "type": "string", "minLength": 1 },
    "mode": { "const": "imagegen" },
    "catalog_scope": { "enum": ["active", "authoring"] },
    "theme_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$" },
    "theme_recipe_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "deck_spec_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider": { "const": "imagegen" },
    "canvas": { "const": "16:9" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "index", "role", "visual_scheme_ref", "visual_scheme_sha256", "prompt_sha256", "model", "size", "quality", "status", "attempts", "asset_role", "text_policy", "output_path", "visual_review"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "index": { "type": "integer", "minimum": 1 },
          "role": { "type": "string", "minLength": 1 },
          "visual_scheme_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$" },
          "visual_scheme_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "prompt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "model": { "type": "string", "minLength": 1 },
          "size": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
          "quality": { "enum": ["low", "medium", "high", "auto"] },
          "status": { "enum": ["prepared", "generated", "failed", "pass", "revise", "unresolved"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "error": { "type": ["string", "null"] },
          "asset_role": { "const": "complete-slide" },
          "text_policy": { "const": "exact-text-in-image" },
          "output_path": { "type": "string", "minLength": 1 },
          "visual_review": { "enum": ["pending", "pass", "fail"] },
          "review_notes": { "type": ["string", "null"] },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "warning": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
