{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-skills.local/storyweave-html/deck_spec.schema.json",
  "title": "StoryWeave HTML approved content by schema version",
  "$comment": "Version routing preserves legacy theme and visual_spec contracts while v4 content comes from the shared core schema.",
  "oneOf": [
    {
      "$ref": "deck_spec.v2.schema.json"
    },
    {
      "$ref": "deck_spec.v3.schema.json"
    },
    {
      "allOf": [
        {
          "$ref": "content_v4.schema.json"
        },
        {
          "properties": {
            "status": {
              "const": "approved"
            }
          },
          "required": [
            "revision",
            "approved_at"
          ]
        }
      ]
    }
  ]
}
