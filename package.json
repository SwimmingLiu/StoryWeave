{
  "name": "storyweave",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "package:skills": "node scripts/package-skills.mjs",
    "check:packages": "node scripts/package-skills.mjs --check",
    "check:themes": "node scripts/build-imagegen-theme-gallery.mjs --check",
    "test": "node --test --test-concurrency=1 tests/core/*.test.mjs tests/design-library/*.test.mjs tests/integration/*.test.mjs tests/packaging/*.test.mjs skills/*/tests/*.test.mjs .agents/skills/verify-storyweave/tests/*.test.mjs",
    "verify:ci": "node .agents/skills/verify-storyweave/scripts/ci.mjs",
    "verify:visual": "node .agents/skills/verify-storyweave/scripts/ci-visual.mjs",
    "doctor": "node .agents/skills/verify-storyweave/scripts/verify.mjs doctor"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
