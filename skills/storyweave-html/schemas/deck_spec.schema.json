{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-skills.local/storyweave-html/deck_spec.schema.json",
  "title": "Storyweave HTML approved deck v3",
  "type": "object",
  "required": ["schema_version", "status", "catalog_scope", "contract_version", "title", "language", "canvas", "mode", "output_mode", "theme_ref", "theme_recipe", "theme_recipe_sha256", "slides", "approved_at"],
  "properties": {
    "schema_version": { "const": 3 },
    "status": { "const": "approved" },
    "catalog_scope": { "enum": ["active", "authoring"] },
    "contract_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "canvas": { "const": "16:9" },
    "reading_mode": { "enum": ["speaker-led", "reading-first"] },
    "mode": { "const": "html" },
    "output_mode": { "const": "standalone-html" },
    "theme_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$" },
    "theme_recipe": { "type": "object" },
    "theme_recipe_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approved_at": { "type": "string", "format": "date-time" },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slide" } }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "required": ["id", "role", "purpose", "claim", "exact_text", "evidence", "visual_brief", "visual_scheme_ref", "visual_anchor_id", "continuity_group", "layout_plan", "visual_scheme_sha256", "render_recipe_ref", "render_recipe_sha256", "motion_recipe_ref", "transition"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "role": { "enum": ["cover", "section", "statement", "image-hero", "two-column", "comparison", "process", "data", "quote", "closing"] },
        "purpose": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "exact_text": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array" },
        "visual_brief": { "type": "string", "minLength": 1 },
        "visual_scheme_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$" },
        "visual_anchor_id": { "type": "string", "minLength": 1 },
        "continuity_group": { "type": "string", "minLength": 1 },
        "page_rhythm": { "enum": ["anchor", "dense", "breathing"] },
        "visual_scheme_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "render_recipe_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\/[A-Za-z0-9_-]+\/[A-Za-z0-9_-]+$" },
        "render_recipe_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "motion_recipe_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\/[A-Za-z0-9_-]+\/[A-Za-z0-9_-]+$" },
        "asset_refs": { "type": "array", "items": { "$ref": "#/$defs/asset_ref" } },
        "layout_plan": { "$ref": "#/$defs/layout_plan" },
        "transition": { "type": "string", "minLength": 1 },
        "sources": { "type": "array" },
        "speaker_notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "layout_plan": {
      "type": "object",
      "required": ["text_safe_zone", "visual_zone", "hierarchy", "density"],
      "properties": {
        "text_safe_zone": { "enum": ["top-left", "top", "top-right", "left", "center", "right", "bottom-left", "bottom", "bottom-right"] },
        "visual_zone": { "type": "array", "minItems": 1, "items": { "enum": ["top-left", "top", "top-right", "left", "center", "right", "bottom-left", "bottom", "bottom-right"] } },
        "hierarchy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "density": { "enum": ["low", "medium", "high"] }
      },
      "additionalProperties": false
    },
    "asset_ref": {
      "type": "object",
      "required": ["asset_id", "slot"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "slot": { "enum": ["hero", "supporting", "background", "logo", "evidence"] },
        "path": { "type": "string", "minLength": 1 },
        "fit": { "enum": ["cover", "contain", "fill"] },
        "crop": { "enum": ["adaptive", "no-crop"] },
        "focal_point": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false },
        "alt": { "type": "string" },
        "caption": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
